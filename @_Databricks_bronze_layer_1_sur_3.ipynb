ve_folder))\\n\",","    \"else:\\n\",","    \"    print(\\\"Aucun fichier parquet trouvé dans le dossier source donc il n'y a rien à ingérer\\\")\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 0,","   \"metadata\": {","    \"application/vnd.databricks.v1+cell\": {","     \"cellMetadata\": {","      \"byteLimit\": 2048000,","      \"rowLimit\": 10000","     },","     \"inputWidgets\": {},","     \"nuid\": \"18fa409c-4b49-468f-a0e5-9f25fb2da1e0\",","     \"showTitle\": false,","     \"tableResultSettingsMap\": {},","     \"title\": \"\"","    }","   },","   \"outputs\": [","    {","     \"output_type\": \"display_data\",","     \"data\": {","      \"text/html\": [","       \"\u003cstyle scoped\u003e\\n\",","       \"  .table-result-container {\\n\",","       \"    max-height: 300px;\\n\",","       \"    overflow: auto;\\n\",","       \"  }\\n\",","       \"  table, th, td {\\n\",","       \"    border: 1px solid black;\\n\",","       \"    border-collapse: collapse;\\n\",","       \"  }\\n\",","       \"  th, td {\\n\",","       \"    padding: 5px;\\n\",","       \"  }\\n\",","       \"  th {\\n\",","       \"    text-align: left;\\n\",","       \"  }\\n\",","       \"\u003c/style\u003e\u003cdiv class='table-result-container'\u003e\u003ctable class='table-result'\u003e\u003cthead style='background-color: white'\u003e\u003ctr\u003e\u003cth\u003eVendorID\u003c/th\u003e\u003cth\u003etpep_pickup_datetime\u003c/th\u003e\u003cth\u003etpep_dropoff_datetime\u003c/th\u003e\u003cth\u003epassenger_count\u003c/th\u003e\u003cth\u003etrip_distance\u003c/th\u003e\u003cth\u003eRatecodeID\u003c/th\u003e\u003cth\u003estore_and_fwd_flag\u003c/th\u003e\u003cth\u003ePULocationID\u003c/th\u003e\u003cth\u003eDOLocationID\u003c/th\u003e\u003cth\u003epayment_type\u003c/th\u003e\u003cth\u003efare_amount\u003c/th\u003e\u003cth\u003eextra\u003c/th\u003e\u003cth\u003emta_tax\u003c/th\u003e\u003cth\u003etip_amount\u003c/th\u003e\u003cth\u003etolls_amount\u003c/th\u00